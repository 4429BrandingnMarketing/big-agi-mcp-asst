{
  "name": "big-agi-mcp-assistant",
  "version": "1.0.0",
  "description": "A standalone desktop application for Big-AGI MCP Assistant",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "package": "electron-builder --dir",
    "dist": "electron-builder --publish never"
  },
  "keywords": [
    "electron",
    "desktop-app",
    "mcp",
    "big-agi",
    "assistant"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "marked": "^11.1.0",
    "highlight.js": "^11.9.0",
    "dompurify": "^3.0.6"
  },
  "build": {
    "appId": "com.bigagi.mcp.assistant",
    "productName": "Big-AGI MCP Assistant",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  }
}
