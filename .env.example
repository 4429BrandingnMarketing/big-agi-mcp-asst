# ============================================
# BIG-AGI MCP ASSISTANT - API CONFIGURATION
# ============================================
# SECURITY: Copy this file to .env and add your actual keys
# NEVER commit .env to git! It's in .gitignore
# ============================================

# ============================================
# AI SERVICES
# ============================================

# OpenAI
OPENAI_API_KEY=your_openai_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-opus-20240229

# Open Router (Multiple Models)
OPEN_ROUTER_API_KEY=your_openrouter_key_here
OPEN_ROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq
GROQ_API_KEY=your_groq_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_google_cse_id_here

# Kimi
KIMI_API_KEY=your_kimi_key_here
KIMI_ORG_ID=your_kimi_org_id_here

# Hugging Face
HUGGING_FACE_API_KEY=your_huggingface_key_here

# Hyperbolic
HYPERBOLIC_API_KEY=your_hyperbolic_key_here

# MiniMax
MINIMAX_API_KEY=your_minimax_key_here

# ============================================
# DEVELOPMENT & TOOLS
# ============================================

# GitHub
GITHUB_TOKEN=your_github_token_here

# Langsmith
LANGSMITH_API_KEY=your_langsmith_key_here

# Sourcegraph
SOURCEGRAPH_API_KEY=your_sourcegraph_key_here

# CopilotKit
COPILOTKIT_PUBLIC_KEY=your_copilotkit_public_key_here
COPILOTKIT_SECRET_KEY=your_copilotkit_secret_key_here

# Langflow
LANGFLOW_API_KEY=your_langflow_key_here

# Stagehand
STAGEHAND_API_KEY=your_stagehand_key_here

# ============================================
# DATABASE & STORAGE
# ============================================

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# PostgreSQL
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bigagi

# Quadrant Vector DB
QUADRANT_API_KEY=your_quadrant_key_here
QUADRANT_URL=your_quadrant_url_here

# Mem0
MEM0_API_KEY=your_mem0_key_here

# Prisma
OPTIMIZE_API_KEY=your_prisma_optimize_key_here

# Graphlit
GRAPHLIT_API_URL=your_graphlit_url_here
GRAPHLIT_ORGANIZATION_ID=your_graphlit_org_id_here
GRAPHLIT_ENVIRONMENT_ID=your_graphlit_env_id_here
GRAPHLIT_SECRET=your_graphlit_secret_here

# ============================================
# CLOUD SERVICES
# ============================================

# Alibaba Cloud
ALIBABA_CLOUD_API_KEY=your_alibaba_api_key_here
ALIBABA_SECRET_KEY=your_alibaba_secret_key_here
ALIBABA_USERNAME=your_alibaba_username_here
ALIBABA_PASSWORD=your_alibaba_password_here

# ============================================
# INTEGRATION SERVICES
# ============================================

# Slack
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_VERIFICATION_TOKEN=your_slack_verification_token_here

# Composio
COMPOSIO_API_KEY=your_composio_key_here

# ============================================
# SEARCH & DISCOVERY
# ============================================

# SerpAPI
SERPAPI_API_KEY=your_serpapi_key_here

# GetLens
GETLENS_API_KEY=your_getlens_key_here

# ============================================
# MEDIA & CONTENT
# ============================================

# Eleven Labs (Text to Speech)
ELEVEN_LABS_API_KEY=your_elevenlabs_key_here

# Stable Diffusion
STABLE_DIFFUSION_KEY=your_stable_diffusion_key_here

# ============================================
# E-COMMERCE
# ============================================

# Printful
PRINTFUL_API_KEY=your_printful_key_here
PRINTFUL_PASSWORD=your_printful_password_here

# Amazon Associates
AMAZON_ASSOCIATES_KEY=your_amazon_associates_key_here

# ============================================
# AI ORCHESTRATION
# ============================================

# AnythingLLM
ANYTHINGLLM_API_KEY=your_anythingllm_key_here

# Smithery MCP
SMITHERY_MCP_API=your_smithery_key_here

# Agent Super
AGENT_SUPER_KEY=your_agent_super_key_here

# Goose Deep Think
GOOSE_DEEP_THINK_API_KEY=your_goose_key_here

# ============================================
# APPLICATION SETTINGS
# ============================================

# Default AI Provider (openai, anthropic, openrouter, etc.)
DEFAULT_AI_PROVIDER=anthropic

# Environment
NODE_ENV=development

# Debug Mode
DEBUG=true

# App Settings
AUTO_SAVE=true
THEME=dark
MAX_TOKENS=4096
TEMPERATURE=0.7

# API Timeout (milliseconds)
API_TIMEOUT=30000

# Retry Configuration
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY=1000
